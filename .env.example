# ============================================================
# VocalVerse 根 .env.example —— 复制为 .env 后填写（.env 严禁入库）
# 实际值只放本机 .env 与 GitHub Secrets；公开仓库永远不出现真实密钥
# ============================================================

# ---- 公共 ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_TIMEZONE=Asia/Shanghai
JWT_SECRET=change-me-please-use-64-char-random
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
SERVICE_TOKEN=change-me-internal-service-token

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vocalverse
POSTGRES_USER=vocalverse
POSTGRES_PASSWORD=change-me-db-password

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Python 服务（services/python/.env.example 同步） ----
# 仅钉本地端口与模式
PYTHON_SERVICE_PORT=8000
