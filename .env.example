# ============================================================
# VocalVerse 根 .env.example —— 复制为 .env 后填写（.env 严禁入库）
# 实际值只放本机 .env 与 GitHub Secrets；公开仓库永远不出现真实密钥
# ============================================================

# ---- 公共（服务间契约密钥：Python 验签/Java 签发/内部委托三处同值；≥32 字节，JJWT 硬性要求） ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_TIMEZONE=Asia/Shanghai
JWT_SECRET=vocalverse-dev-jwt-secret-0123456789abcdef
APP_JWT_SECRET=vocalverse-dev-jwt-secret-0123456789abcdef
SERVICE_TOKEN=change-me-internal-service-token
APP_SERVICE_TOKEN=change-me-internal-service-token

# ---- PostgreSQL ----
# 注意：默认值必须与 docker-compose.yml 服务内的 ${...:-vocalverse-dev} 回退一致，
# 否则 compose 会用 .env 里的密码重建 PG（数据清空 + 三端密码失配）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vocalverse
POSTGRES_USER=vocalverse
POSTGRES_PASSWORD=vocalverse-dev

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Python 服务（M2 真实管线密钥；缺省时走 Fake，见 services/python/.env.example） ----
APP_DEEPSEEK_API_KEY=
APP_DEEPSEEK_BASE_URL=https://api.deepseek.com
APP_DEEPSEEK_MODEL=deepseek-chat
APP_ISE_APP_ID=
APP_ISE_API_KEY=
APP_ISE_API_SECRET=
APP_ASR_MODEL=small
APP_JAVA_BASE_URL=http://localhost:8080
# 媒体存储（社区 S3 · docs/47 §4.1）：容器内挂载 ./data/media；
# 视频上限改动必须同步 apps/web/nginx.conf 的 client_max_body_size（docs/48 B3）
APP_MEDIA_DIR=./data/media
APP_MEDIA_MAX_VIDEO_BYTES=67108864

# ---- Python 服务（services/python/.env.example 同步） ----
# 仅钉本地端口与模式
PYTHON_SERVICE_PORT=8000

# ---- 管理端控制台（docs/50）----
# 控制台令牌密钥：Java 签发、Python 验签，**两端必须同值**。
#
# ⚠️ 两个键名是**同一个值的两份拷贝**，因为两端的配置前缀本来就不同（不是笔误，也别只填一个）：
#     Java  读 `VOICEVERSE_CONSOLE_JWT_SECRET`（`vocalverse.console.jwt-secret`，见 ConsoleJwtService）
#     Python 读 `APP_CONSOLE_JWT_SECRET`（`services/python/app/core/config.py`）
#
# ⚠️ 为什么必须在**根** .env 里同时写上：方式 B（`scripts/dev-up.ps1`）只注入根 `.env`，
#     而 **Spring Boot 根本不读 `.env` 文件**（application.yml 无 `spring.config.import`，
#     也没有 dotenv 的 EnvironmentPostProcessor）——`services/java/.env.example` 里的变量
#     在方式 B 下没人加载。只填 Python 那个键的后果是静默的：
#     Java 拿不到控制台密钥 → **回退用下面的 JWT_SECRET 签发**（ConsoleJwtService 有显式回退分支），
#     Python 却用 APP_CONSOLE_JWT_SECRET 验签 → **运维 / LLM trace / 书籍 / 媒体等 Python 侧
#     控制台端点全量 401**，且报错里不会提示"密钥不一致"。
#     留空 Java 侧 = 回退 App 密钥（仅回退期可用）；生产必须配一个与 JWT_SECRET **不同**的值，
#     Python 侧启动时会断言两者不同。
#
# 另：首个 super 管理员是**一次性 opt-in 引导**（`admin_users` 为空 + 用户名口令均非空才建号），
# 变量清单见 `services/java/.env.example` 的 bootstrap 段；不配就没有任何账号可登录控制台。
VOICEVERSE_CONSOLE_JWT_SECRET=
APP_CONSOLE_JWT_SECRET=
# LLM trace 结构采集（span 树：模型/token/耗时/状态，**不含内容**）
APP_LLM_TRACE_ENABLED=true
# LLM trace **内容**捕获（prompt/response）——隐私敏感，默认关；
# 开启即构成 docs/06 §9.7 的受控例外，**生产禁止开启**（答辩域无论如何都硬排除）
APP_LLM_TRACE_CONTENT_CAPTURE=false
# 运维指标采集器（60s 桶）与预警评估；关闭后控制台运维页返回 46014
APP_OPS_TELEMETRY_ENABLED=true
