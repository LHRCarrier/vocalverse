# ============================================================
# VocalVerse Python 服务环境示例 —— 复制为 .env 填写（.env 严禁入库）
# 说明：根目录 .env 在 docker compose 下自动注入；本文件提供
#       本机 venv 开发（uv run uvicorn）所需变量
# ============================================================
APP_ENV=development
APP_TESTING=false
APP_LOG_LEVEL=INFO

# 与 docker-compose.yml 默认一致（POSTGRES_USER/PASSWORD 默认 vocalverse/vocalverse-dev）：
# 复制即用零配置；改密码时三处同步（compose 环境变量 / 本行 / 根 .env 的 POSTGRES_PASSWORD）
APP_DATABASE_URL=postgresql+psycopg://vocalverse:vocalverse-dev@localhost:5432/vocalverse
APP_REDIS_URL=redis://localhost:6379/0
APP_REDIS_REQUIRED=false

APP_JWT_SECRET=vocalverse-dev-jwt-secret-0123456789abcdef
APP_SERVICE_TOKEN=change-me-internal-service-token

APP_DEEPSEEK_API_KEY=
APP_DEEPSEEK_BASE_URL=https://api.deepseek.com
APP_DEEPSEEK_MODEL=deepseek-chat

# ---- ASR / TTS 引擎（可插拔；2026-09 重构，见 docs/audit/ASR-TTS链路审计与重构方案.md）----
# 选择语义：显式名字直取；auto 按各引擎 priority 探测 is_available() 取第一个可用。
# 引擎清单见 app/audio/registry.py（注册表单一真源），实现见 app/audio/{asr,tts}*.py。
APP_ASR_PROVIDER=auto
APP_ASR_MODEL=small
APP_ASR_DEVICE=cpu
APP_ASR_COMPUTE_TYPE=int8
# sherpa-onnx 本地轻量 ASR（可选依赖：uv sync --extra local-asr）；目录留空=不探测该引擎。
# ⚠️ sherpa 不产出词级时间戳 → 流利度 wpm/停顿特征为空（下游已按「无时间戳」降级）。
APP_ASR_SHERPA_MODEL_DIR=
APP_ASR_SHERPA_MODEL_TYPE=sense_voice
APP_ASR_SHERPA_NUM_THREADS=2

APP_TTS_PROVIDER=auto
APP_AZURE_TTS_KEY=
APP_KITTEN_VOICE=Jasper
# 本地 GPU 边车 · OmniVoice 参考件音色（英语音色 The Anchor / The Podcaster）：
#   边车在本仓：services/omnivoice-sidecar/（README 与 scripts/start-omnivoice-sidecar.ps1）
#   APP_VOICE_REFS_DIR：参考件目录；**留空 = 自动用仓库内 data/seed/voices**（随仓库分发）
#   APP_TTS_OMNIVOICE_ENDPOINT：边车地址（默认 http://127.0.0.1:8765）
#   APP_TTS_OMNIVOICE_VOICE=anchor-en        # anchor-en（英文男声）| podcaster-en（英文女声）
# auto 链本地优先：omnivoice → kitten → edge；边车未起时健康探测失败即自动回落，不阻塞链路。
# 模型权重（约 3.3 GB）不入库，只做运行时路径引用（边车侧用 -HfCache / OMNIVOICE_HF_CACHE 指）。
APP_VOICE_REFS_DIR=
APP_TTS_OMNIVOICE_VOICE=anchor-en
APP_TTS_OMNIVOICE_TIMEOUT_S=120

APP_ISE_APP_ID=
APP_ISE_API_KEY=
APP_ISE_API_SECRET=

APP_MAX_UPLOAD_BYTES=20971520
APP_MAX_SPEECH_SECONDS=60
APP_MAX_SING_SECONDS=180
APP_AUDIO_TTL_HOURS=24

# ---- 共享卷目录（裸跑必读；2026-09-14 · A-G7「路径三义性」）----
# 两个默认值 `./data/audio` / `./data/media` 是**按进程 cwd 解析**的相对路径：
#   · 容器：WORKDIR /app + 挂载卷 → `./data/audio` 恰好 = `/app/data/audio`，**不用配**；
#   · 裸跑（README 方式 B）：cwd = services/python → 会落到 `services/python/data/audio`
#     （那里只有用户录音），而素材在**仓库根** data/  → 已发布歌曲的参考旋律找不到，
#     `GET /api/v1/audio/{name}` 回 40401「audio asset missing」：前端只表现为
#     「**听参考旋律点了没反应**」，看着像曲库没素材、不像配置错，极难反查（2026-09-14 实测）。
# 故裸跑务必显式指向仓库根（下面这份相对写法以 cwd=services/python 为前提，跨机器可复制）。
# ⚠️ 不要改成仓库根的**绝对路径**再跑 pytest：测试用的是 `data/audio-test`（conftest 注入），
#    只有你把它 export 到 shell 环境变量里时才会盖掉 conftest 的默认值、让单测误删真素材。
APP_AUDIO_DIR=../../data/audio
APP_MEDIA_DIR=../../data/media

# ---- 唱歌（docs/06 §9.4 + 2026-09-09 P0 D1~D7；值有代码默认，占位同默认） ----
# ISE 桶 30/h（R-16 闭合）+ sing 独立桶 5/h（整首计 1）
APP_ISE_RATE_PER_HOUR=30
APP_SING_RATE_PER_HOUR=5
# 参考旋律提取（pyin 65~800Hz/frame 2048/hop 512；fake 仅测试）
APP_PITCH_EXTRACTOR=pyin
APP_PITCH_EXTRACT_CONCURRENCY=2
APP_PITCH_EXTRACT_SCAN_INTERVAL_S=60
APP_PITCH_EXTRACT_MAX_ATTEMPTS=3
# 发音=整首抽样句（默认前 3 句 + weak 句优先；0=关闭发音分）
APP_SING_PRON_SAMPLES=3
APP_SING_CONCURRENCY=2
# 读书域听书（docs/45 §5）：留空=跟随 APP_TTS_PROVIDER；auto=kitten/omnivoice 可用则用，否则 edge；
# 显式指定本地引擎但不可用 → 503（不静默换云引擎）。voice_models_dir 填 VoiceStudio 模型目录启用
# KittenTTS（模型权重不入库红线）
APP_READING_TTS_PROVIDER=auto
APP_VOICE_MODELS_DIR=
APP_READING_TTS_RATE_PER_HOUR=600

# ---- 管理端控制台 · 运维域（docs/50 §7 §8 §9）----
# 控制台令牌密钥：Java 签发、Python 验签，**必须与 Java 的 VOICEVERSE_CONSOLE_JWT_SECRET 同值**。
# 留空时 development 档会告警并让控制台端点一律 46001（fail-closed，绝不用空密钥验签）；
# 生产档若与 APP_JWT_SECRET 相同则**拒绝启动**（同密钥时 audience 校验是唯一闸门）。
APP_CONSOLE_JWT_SECRET=
# LLM trace 结构采集（span 树 ENTRY→AGENT→STEP→{LLM,TOOL}；**不含 prompt/response**）
APP_LLM_TRACE_ENABLED=true
# LLM trace **内容**捕获。默认 false = llm_span_contents 零行，且结构/内容分表，可自证"没存 prompt"。
# 开启即构成 docs/06 §9.7 的受控例外：**生产禁止开启**；答辩域（kind=defense/thesis）无论开关如何都硬排除。
APP_LLM_TRACE_CONTENT_CAPTURE=false
# 内容单条上限（超出截断并置 truncated）；对齐 DSH 导出器默认值
APP_LLM_TRACE_CONTENT_MAX_CHARS=128000
# 采样率（1.0=全采）
APP_LLM_TRACE_SAMPLE_RATE=1.0
# 保留期：trace 结构 30 天 / 内容 72 小时
APP_LLM_TRACE_RETENTION_DAYS=30
APP_LLM_SPAN_CONTENT_RETENTION_HOURS=72
# 运维指标采集器（60s 一桶）与预警评估；关闭后控制台运维页返回 46014
APP_OPS_TELEMETRY_ENABLED=true
APP_OPS_TELEMETRY_INTERVAL_S=60
# 指标保留 30 天（趋势图窗口上限；docs/50 §12 图表 #1/#2 依赖）
APP_OPS_METRIC_RETENTION_DAYS=30
