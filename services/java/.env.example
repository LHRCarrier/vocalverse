# ============================================================
# VocalVerse Java 管理端环境变量示例 —— 方式 B（本机 mvn spring-boot:run）按需导出：
#   $env:DB_HOST='localhost'; $env:DB_PASSWORD='vocalverse-dev'; mvn spring-boot:run
# 方式 A（compose）由根 .env 经 docker-compose.yml 注入（DB_PASSWORD=${POSTGRES_PASSWORD:-vocalverse-dev}），
# 本文件不参与；密码与根 .env / services/python/.env 三处同步（默认 vocalverse-dev）。
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vocalverse
DB_USER=vocalverse
DB_PASSWORD=vocalverse-dev
JWT_SECRET=vocalverse-dev-jwt-secret-0123456789abcdef

# ============================================================
# 管理端控制台（docs/50）—— 独立身份体系，与上面的 App JWT 分开
# ============================================================

# 控制台令牌密钥（Java 签、Python 验，**两端必须同值**）。
# ⚠️ 生产脚枪：只配一处 → Python 侧控制台端点（运维/trace/书籍/媒体）**全量 401**；
#    App 业务端点不受影响（它们走 JWT_SECRET）。
# 留空时回退到 JWT_SECRET —— 回退期间 audience 校验是唯一闸门（见 ConsoleJwtService 注释），
# 生产必须显式配置一个**不同的**值；Python 侧启动时会断言两密钥不同，相同则拒绝启动。
VOICEVERSE_CONSOLE_JWT_SECRET=

# 控制台 API 挂载开关（默认 true）。关闭后 /api/v1/console/** 返回 404。
VOICEVERSE_CONSOLE_ENABLED=true

# 控制台是否暴露 LLM trace 内容页（默认 false，与 Python 侧
# APP_LLM_TRACE_CONTENT_CAPTURE **双闸**：任一关即不可见）。生产禁止开启。
VOICEVERSE_CONSOLE_LLM_CONTENT_CAPTURE=false

# 控制台前端来源（CORS）。dev 用 vite 代理时其实不触发跨域，仅在分离部署时需要。
# 逗号分隔；留空 = 不加控制台来源（既有白名单不变）。
VOICEVERSE_CONSOLE_CORS_ORIGINS=http://localhost:5174

# ---- 首个 super 管理员的一次性 bootstrap（docs/50 §4.1.1）----
# 仅当 admin_users 为空时创建；弱口令/默认口令会被拒绝并打 ERROR（不留默认口令后门）；
# 日志只打印账号名、**永不打印口令**。上线后请清空这三项。
VOICEVERSE_CONSOLE_BOOTSTRAP_USERNAME=
VOICEVERSE_CONSOLE_BOOTSTRAP_PASSWORD=
VOICEVERSE_CONSOLE_BOOTSTRAP_DISPLAY_NAME=
