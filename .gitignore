# ============================================================
# VocalVerse .gitignore —— 按路径忽略大文件/产物（不用裸后缀黑名单）
# 豁免规则：data/seed/**、*.lrc、tests/fixtures/** 必须可提交
# ============================================================
# --- # 本地工作文档（协作过程产生的临时/内部文档，不入库）---
local/
# --- AI 助手（WorkBuddy）工作区：会话记忆/临时产物，纯本机数据，不入库 ---
.workbuddy/
# --- Node / 前端 ---
node_modules/
dist/
*.local
.vite/
coverage/
*.tsbuildinfo
apps/web/.nuxt/
apps/web/.output/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
# OmniVoice 边车专用环境（scripts/setup-omnivoice-env.ps1 建在这里；`scripts/lib/omnivoice.ps1`
# 会优先搜它）。torch+cu128 约 3~5 GB，绝不入库。
.venv-omnivoice/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
uv.lock.bak
services/python/.eggs/
*.egg-info/

# --- Java ---
services/java/target/
*.class

# --- 密钥与环境 ---
.env
.env.*
!.env.example
.idea/
*.pem
*.key

# --- 数据与训练产物（按路径，而非裸后缀） ---
data/audio/
# 媒体卷（社区 S3 · docs/47 §4.1）：上传的图片/视频/头像一律不入库。
# 注意 gitignore 语义：含斜杠的模式锚定仓库根 → `data/media/` 只匹配根目录，
# 本地裸跑（uvicorn cwd=services/python）会落在 services/python/data/media，需单列。
data/media/
services/python/data/
data/raw/
# HF 模型权重（faster-whisper / OmniVoice 等）：红线禁止提交（2026-09-04 复审补）
# ⚠️ 2026-09-21 修：本行原写作 `data/models/   # HF 模型权重…` —— **行内注释会让整条模式失效**
#    （gitignore 的 `#` 只在行首才算注释，行尾那段会被当成模式的一部分）⇒ 该忽略**从未生效**，
#    `git add -A` 会把 3.3 GB 权重暂存进去。实测判据：`git check-ignore -v data/models/x` 有输出才算生效。
data/models/
# 注意：必须锚定路径！裸 `models/` 会吞掉 services/python/app/models（schema 模型，必须入库）
/models/
services/python/models/
*.pth
*.h5
*.onnx
*.safetensors
*.pt
*.ckpt
*.db
*.sqlite3
*.log
htmlcov/
*.coverage

# --- 测试夹具、seed、歌词 必须可提交（豁免） ---
!data/seed/
!data/seed/**
!**/*.lrc
!**/tests/fixtures/

# --- 系统 / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- 大音频不提交（样例音频走 fixture 目录豁免） ---
*.wav
*.mp3
*.ogg
*.m4a
# 在豁免区下方重复豁免 fixture 目录，确保优先级
!**/tests/fixtures/**
# 音色参考件（data/seed/voices/，2026-09-21）：OmniVoice 零样本克隆的**音色身份本体**
# —— 音色 = 参考件字节 + 参考文本 + seed，缺了它边车合成不出任何声音，队友 clone 下来
# 也跑不通。合计约 1.9 MB（4 个 wav + VOICES.json），随仓库分发。
# 注意：**模型权重（约 3.3 GB）仍然不入库**（红线），只在运行时按路径引用。
!data/seed/voices/
!data/seed/voices/**

# HF 模型下载缓存（构建上下文预下载用；红线禁止提交，2026-09-07）
services/python/.models-cache/

# --- Java 本地访问日志（2026-09-10 手机联调排障开启） ---
services/java/logs/
