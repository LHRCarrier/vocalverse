# ============================================================
# VocalVerse .gitignore —— 按路径忽略大文件/产物（不用裸后缀黑名单）
# 豁免规则：data/seed/**、*.lrc、tests/fixtures/** 必须可提交
# ============================================================
# --- # 本地工作文档（协作过程产生的临时/内部文档，不入库）---
local/
# --- Node / 前端 ---
node_modules/
dist/
*.local
.vite/
coverage/
*.tsbuildinfo
apps/web/.nuxt/
apps/web/.output/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
uv.lock.bak
services/python/.eggs/
*.egg-info/

# --- Java ---
services/java/target/
*.class

# --- 密钥与环境 ---
.env
.env.*
!.env.example
.idea/
*.pem
*.key

# --- 数据与训练产物（按路径，而非裸后缀） ---
data/audio/
# 媒体卷（社区 S3 · docs/47 §4.1）：上传的图片/视频/头像一律不入库。
# 注意 gitignore 语义：含斜杠的模式锚定仓库根 → `data/media/` 只匹配根目录，
# 本地裸跑（uvicorn cwd=services/python）会落在 services/python/data/media，需单列。
data/media/
services/python/data/
data/raw/
data/models/   # HF 模型权重（faster-whisper 等）：红线禁止提交（2026-09-04 复审补，曾未忽略）
# 注意：必须锚定路径！裸 `models/` 会吞掉 services/python/app/models（schema 模型，必须入库）
/models/
services/python/models/
*.pth
*.h5
*.onnx
*.safetensors
*.pt
*.ckpt
*.db
*.sqlite3
*.log
htmlcov/
*.coverage

# --- 测试夹具、seed、歌词 必须可提交（豁免） ---
!data/seed/
!data/seed/**
!**/*.lrc
!**/tests/fixtures/

# --- 系统 / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- 大音频不提交（样例音频走 fixture 目录豁免） ---
*.wav
*.mp3
*.ogg
*.m4a
# 在豁免区下方重复豁免 fixture 目录，确保优先级
!**/tests/fixtures/**

# HF 模型下载缓存（构建上下文预下载用；红线禁止提交，2026-09-07）
services/python/.models-cache/

# --- Java 本地访问日志（2026-09-10 手机联调排障开启） ---
services/java/logs/
