{
  "name": "vocalverse-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "gen:api": "openapi-typescript src/api/specs/python-openapi.json -o src/api/generated/python-api.d.ts && openapi-typescript src/api/specs/java-openapi.json -o src/api/generated/java-api.d.ts"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "echarts": "^6.1.0",
    "naive-ui": "^2.45.3",
    "p5": "^1.11.13",
    "pinia": "^4.0.3",
    "unocss": "^66.8.1",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/tabler": "^1.2.38",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.0",
    "@types/p5": "^1.7.7",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.31.0",
    "happy-dom": "^20.12.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.15.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.0.3",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.1.10"
  }
}
