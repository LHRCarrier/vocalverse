{
  "name": "vocalverse-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VocalVerse 管理端控制台（独立 SPA · 运维/运营/审核三角色 RBAC）",
  "packageManager": "pnpm@9.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "unocss": "^66.8.1",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.38",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.15.0",
    "eslint-plugin-vue": "^9.31.0",
    "happy-dom": "^20.12.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.0.3",
    "vitest": "^3.0.0",
    "vue-tsc": "^2.1.10"
  }
}
